# Gemini API Key (Required for AI Orchestrator & Google Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (default: gemini-3.8-flash; high-reasoning option: gemini-4-argon)
GEMINI_MODEL=gemini-3.8-flash

# Risk-Free Rate (Annualized RBI 91-Day T-Bill Yield in decimal, e.g. 0.066 for 6.6%)
RISK_FREE_RATE=0.066

# In-memory TTL Cache duration in seconds (default: 1800 = 30 mins)
CACHE_TTL_SECONDS=1800

